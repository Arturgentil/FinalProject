# Copie para .env e ajuste os valores.

# String de conexão do Postgres: postgresql://usuario:senha@host:porta/banco
DATABASE_URL=postgresql://stepvolt:stepvolt@localhost:5432/stepvolt

# Segredo usado para assinar os tokens JWT - troque por algo aleatório e longo
JWT_SECRET=troque-isso-por-uma-string-aleatoria-bem-grande

# Porta em que a API vai escutar
PORT=3000

# --- Análise de IA (opcional) ---
# Sem estas variáveis, /api/ai/insights responde com uma leitura por regras
# calculada no próprio servidor — o app funciona normalmente de qualquer jeito.
# Para ligar um provedor externo, preencha AI_API_KEY e, se quiser, ajuste o
# provedor e o modelo.
# AI_PROVIDER=anthropic          # ou "openai"
# AI_API_KEY=
# AI_MODEL=claude-sonnet-4-6     # ou algo como gpt-4o-mini para a OpenAI


# --- Sessão e segurança (V4) ---
# Tempo de vida do token de acesso e do token de renovação.
# ACCESS_TOKEN_TTL=1h
# REFRESH_TOKEN_DAYS=60
# Limite geral de requisições por minuto por IP (padrão 300).
# RATE_LIMIT_PER_MIN=300
# Atrás de proxy (Render, Nginx) deixe como está; para desligar: TRUST_PROXY=0

# --- E-mail de confirmação (opcional) ---
# Sem SMTP_URL o link de confirmação só aparece no log do servidor.
# SMTP_URL=smtps://usuario:senha@smtp.exemplo.com:465
# MAIL_FROM=StepVolt <nao-responda@exemplo.com>
# URL pública da API, usada no link do e-mail (padrão: o endereço da requisição)
# PUBLIC_URL=https://sua-api.exemplo.com

# --- Login com Google (opcional) ---
# ID do cliente OAuth (tipo Web) criado no Google Cloud Console. Sem isto a
# rota /api/auth/google responde que não está configurada.
# GOOGLE_CLIENT_ID=
