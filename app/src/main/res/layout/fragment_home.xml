<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/sp_6">

        <!-- Cabeçalho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingTop="@dimen/status_inset"
            android:paddingBottom="@dimen/sp_3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtGreeting"
                    style="@style/TextCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Olá" />

                <TextView
                    android:id="@+id/txtGreetingName"
                    style="@style/ScreenTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp">

                <ImageButton
                    android:id="@+id/btnAlerts"
                    style="@style/GhostIconButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:contentDescription="Avisos"
                    android:src="@drawable/ic_bell2"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/badgeAlerts"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_badge"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgProfile"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_avatar_placeholder"
                android:contentDescription="Seu perfil"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/RoundedCircle" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter">

            <!-- Estado da ligação: sempre a primeira coisa da tela -->
            <LinearLayout
                android:id="@+id/cardConnection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <View
                    android:id="@+id/dotConnection"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/dot_idle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtConnTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/conn_disconnected"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtConnSub"
                        style="@style/TextCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnConnAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_button_primary"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="16dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="9dp"
                    android:text="@string/conn_connect"
                    android:textColor="@color/black_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Bloco ao vivo -->
            <LinearLayout
                android:id="@+id/liveSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/panelGauge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingTop="18dp"
                    android:paddingBottom="16dp">

                    <com.stepvolt.app.ui.views.GaugeView
                        android:id="@+id/gaugeMain"
                        android:layout_width="match_parent"
                        android:layout_height="200dp" />

                    <com.stepvolt.app.ui.views.SparklineView
                        android:id="@+id/sparkLive"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="16dp" />

                    <TextView
                        android:id="@+id/txtLiveMeta"
                        style="@style/TextCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="16dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- Sessão -->
            <LinearLayout
                android:id="@+id/panelSession"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sessão" />

                        <TextView
                            android:id="@+id/txtStopwatch"
                            style="@style/Readout.L"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="0:00" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="20dp">

                        <TextView
                            style="@style/TextCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Passos" />

                        <TextView
                            android:id="@+id/txtSessionSteps"
                            style="@style/Readout.M"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Energia" />

                        <TextView
                            android:id="@+id/txtSessionEnergy"
                            style="@style/Readout.M"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0,0" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnSession"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_button_primary"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:text="Iniciar sessão"
                    android:textColor="@color/black_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtSessionHint"
                    style="@style/TextCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Conecte o tênis para gravar uma sessão." />
            </LinearLayout>

            <!-- Resumo do dia -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hoje" />

                    <TextView
                        android:id="@+id/txtTodayEnergy"
                        style="@style/TextCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtTodaySteps"
                        style="@style/Readout.XL"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0" />

                    <TextView
                        android:id="@+id/txtTodayGoal"
                        style="@style/TextCaption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginBottom="6dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressToday"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_energy" />

                <com.stepvolt.app.ui.views.BarsView
                    android:id="@+id/barsToday"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/txtTodayHint"
                    style="@style/TextCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Passos por hora ao longo do dia." />
            </LinearLayout>

            <!-- Avisos recentes e atalhos, montados em código -->
            <LinearLayout
                android:id="@+id/alertsPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/quickLinks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
