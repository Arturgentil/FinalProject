<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <FrameLayout
        android:id="@id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/Widget.MaterialComponents.BottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_height"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_nav_bar"
        app:elevation="0dp"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/nav_item"
        app:itemTextColor="@color/nav_item"
        app:itemRippleColor="#1AFFFFFF"
        app:itemTextAppearanceActive="@style/BottomNavLabelActive"
        app:itemTextAppearanceInactive="@style/BottomNavLabelInactive"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />

</FrameLayout>
