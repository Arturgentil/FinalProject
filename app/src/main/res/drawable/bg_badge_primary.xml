<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- anel na cor do fundo: o selo "descola" da foto -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/bg" />
        </shape>
    </item>
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#00F5A0" android:endColor="#00C88A" android:type="linear" />
        </shape>
    </item>
</layer-list>
